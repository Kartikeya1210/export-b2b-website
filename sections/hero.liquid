<section class="hero">
  <div class="page-width">
    <h1 class="hero__title h1">{{ section.settings.heading }}</h1>
    <p class="hero__subtitle">{{ section.settings.subheading }}</p>
    <a href="{{ section.settings.cta_link | default: routes.collections_url }}" class="btn btn--primary">
      {{ section.settings.cta_text }}
    </a>
  </div>
</section>

{% schema %}
{
  "name": "Hero",
  "tag": "section",
  "class": "section-hero",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Wholesale Catalog"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Browse products and place bulk orders. Simple pricing, fast fulfillment."
    },
    {
      "type": "text",
      "id": "cta_text",
      "label": "Button text",
      "default": "View catalog"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "Button link"
    }
  ]
}
{% endschema %}
